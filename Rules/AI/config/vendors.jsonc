// Rules4AI 厂商配置。改完推送到 main，scripts/build.py 会重新生成 Clash/ 和 Surge/。
// 只支持整行的 // 注释。
{
  // ================================================================
  // 全局设置
  // ================================================================

  // 拒绝收录的过宽 DOMAIN-SUFFIX（只拦截完全相同的后缀，
  // 比如 openai.com.cdn.cloudflare.net 不受 cloudflare.net 影响）
  "global_deny_suffix": [
    "amazonaws.com",
    "azure.com",
    "azureedge.net",
    "azurefd.net",
    "bing.com",
    "cloudflare.com",
    "cloudflare.net",
    "cloudfront.net",
    "core.windows.net",
    "github.com",
    "githubusercontent.com",
    "google.com",
    "googleapis.com",
    "gstatic.com",
    "livekit.cloud",
    "microsoft.com",
    "sentry.io",
    "windows.net",
    "x.com"
  ],

  // v2fly 中带这些属性的条目会被丢弃
  "v2fly_exclude_attrs": ["cn"],

  // v2fly 中带这些属性的条目（广告 / 遥测）放进拒绝列表，而不是普通规则
  "v2fly_reject_attrs": ["ads", "telemetry"],

  "vendors": [
    // ================================================================
    // OpenAI：ChatGPT / Sora / Codex / API
    // ================================================================
    {
      "name": "OpenAI",
      "description": "OpenAI: ChatGPT, Sora, Codex, OpenAI API",
      "sources": [
        {"type": "v2fly", "list": "openai"},
        // OpenAI 自有 ASN（目前没有宣告网段，有了会自动收录）
        {"type": "asn", "asn": 401864}
      ],
      // 替代上游 regexp：chatgpt-async-webps-prod-*.webpubsub.azure.com
      "domain_keyword": ["chatgpt-async-webps-prod-"],
      // openai.fm：OpenAI 官方 TTS 演示站（developers.openai.com/showcase/openai-fm 列出），NS 为 Azure DNS（与 openai.com 相同）
      "domain_suffix": ["openai.fm"],
      // OpenAI 登录用的 Arkose 人机验证专用主机（blackmatrix7 / ACL4SSR 等社区规则长期收录）
      "domain": ["openai-api.arkoselabs.com"]
    },

    // ================================================================
    // Anthropic：Claude / Claude Code / API
    // ================================================================
    {
      "name": "Anthropic",
      "description": "Anthropic: Claude, Claude Code, Claude API",
      "sources": [
        {"type": "v2fly", "list": "anthropic"},
        // Anthropic 自有 ASN
        {"type": "asn", "asn": 399358},
        {"type": "asn", "asn": 400243},
        {"type": "asn", "asn": 401551},
        // 官方文档中的 Inbound IP 段
        {"type": "anthropic_docs", "url": "https://platform.claude.com/docs/en/api/ip-addresses"}
      ],
      // 官方文档公布的入站 IP，作为兜底
      "ip_cidr": ["160.79.104.0/23", "2607:6bc0::/48"]
    },

    // ================================================================
    // xAI：Grok / API
    // ================================================================
    {
      "name": "xAI",
      "description": "xAI: Grok, Grok API",
      "sources": [
        {"type": "v2fly", "list": "xai"},
        // xAI 自有 ASN
        {"type": "asn", "asn": 400297}
      ],
      // grokusercontent.com：grok.com 页面直接引用 assets. / artifacts. / mcp-sandbox.grokusercontent.com，
      // 且与 grok.com 使用同一组 Cloudflare NS（cartman / robin）
      "domain_suffix": ["grokusercontent.com"]
    },

    // ================================================================
    // Google：Gemini / AI Studio / NotebookLM / DeepMind 等
    // （走 Google 共用网段，不收录 IP）
    // ================================================================
    {
      "name": "Gemini",
      "description": "Google: Gemini, AI Studio, NotebookLM, DeepMind, Jules, Antigravity",
      "sources": [
        {"type": "v2fly", "list": "google-deepmind"}
      ],
      // opal.withgoogle.com 跳转到 opal.google，opal.goog 用 Google 的 NS 和证书
      // ai.dev、aistudio.google 跳转到 aistudio.google.com，NS 为 googledomains
      // geminicli.com：Gemini CLI 官网，NS 为 googledomains；codeassist.google：Gemini Code Assist，Google NS，跳转到 Google 文档
      // gemini.app.google：Gemini App 链接域（gemini.google.com 页面引用），Google NS；ai.google：Google AI 官网，Google NS
      "domain_suffix": [
        "opal.withgoogle.com",
        "opal.goog",
        "ai.dev",
        "aistudio.google",
        "geminicli.com",
        "codeassist.google",
        "gemini.app.google",
        "ai.google"
      ],
      // Google AI 产品的专用主机（google.com / googleapis.com 整段太宽，只收主机）：
      // Antigravity、Jules、AI Studio、Vertex AI、Gemini、NotebookLM 企业版
      // 2026-11 新增：
      //   aiplatform.{us,eu}.rep / aiplatform.mtls：Vertex AI 的区域 / mTLS 端点（us/eu.rep 有独立 DNS 记录）
      //   discoveryengine / us- / eu-discoveryengine：Gemini Enterprise 的 API（Google Cloud 文档）
      //   businessaicode：Gemini Code Assist 企业版 API（Google Cloud 审计日志文档）
      //   gemini.cloud.google.com：跳转到 Cloud 控制台的 Gemini Cloud Assist
      //   mixboard.google.com：Google Labs 的 AI 产品 Mixboard
      "domain": [
        "aiplatform.googleapis.com",
        "aiplatform.eu.rep.googleapis.com",
        "aiplatform.mtls.googleapis.com",
        "aiplatform.us.rep.googleapis.com",
        "businessaicode.googleapis.com",
        "discoveryengine.googleapis.com",
        "eu-discoveryengine.googleapis.com",
        "gemini.cloud.google.com",
        "mixboard.google.com",
        "us-discoveryengine.googleapis.com",
        "alkalimakersuite-pa.googleapis.com",
        "antigravity.google.com",
        "jetski-webchannel-pa.googleapis.com",
        "jetski-webchannel.googleapis.com",
        "jules.googleapis.com",
        "notebooklm.cloud.google.com",
        "webchannel-robinfrontend-pa.googleapis.com"
      ]
    },

    // ================================================================
    // Perplexity
    // ================================================================
    {
      "name": "Perplexity",
      "description": "Perplexity AI",
      "sources": [
        {"type": "v2fly", "list": "perplexity"}
      ]
    },

    // ================================================================
    // Microsoft：Copilot + GitHub Copilot
    // ================================================================
    {
      "name": "Copilot",
      "description": "Microsoft Copilot and GitHub Copilot",
      "sources": [
        // GitHub Copilot
        {"type": "v2fly", "list": "github-copilot"}
      ],
      // Microsoft Copilot（v2fly 没有单独列表，手工维护）
      // copilot.com 证书 O=Microsoft Corporation
      // copilot.ai 跳转到 copilot.com，NS 为 Azure DNS
      "domain_suffix": [
        "copilot.com",
        "copilot.ai",
        "copilot.microsoft.com",
        "copilot.cloud.microsoft"
      ],
      // origin-tracker.githubusercontent.com：GitHub Copilot allowlist 文档列出（公共代码匹配）
      // copilotstudio.microsoft.com：Microsoft Copilot Studio
      "domain": [
        "copilot-reports.github.com",
        "origin-tracker.githubusercontent.com",
        "copilotstudio.microsoft.com",
        "sydney.bing.com",
        "edgeservices.bing.com"
      ]
    },

    // ================================================================
    // Meta：Meta AI / Llama（v2fly 没有单独列表，手工维护）
    // ================================================================
    {
      "name": "MetaAI",
      "description": "Meta AI and Llama",
      "sources": [],
      // metaaiusercontent.com / metaaivm.com 用 Meta 自己的 NS（来自 v2fly category-ai-!cn）
      "domain_suffix": [
        "meta.ai",
        "llama.com",
        "metaaiusercontent.com",
        "metaaivm.com",
        // ai.meta.com：Meta AI 官网（AI at Meta），NS 为 ns.facebook.com
        "ai.meta.com"
      ],
      // Llama 开发者站，跳转到 dev.meta.ai，NS 为 ns.facebook.com
      "domain": [
        "llama.meta.com",
        "llama.developer.meta.com"
      ]
    }
  ],

  // ================================================================
  // 合集：以上所有厂商合并为 AI.list / AI.yaml
  // ================================================================
  "aggregate": {
    "name": "AI_All",
    "description": "OpenAI、Anthropic、xAI、Gemini 等 AI 服务合集"
  },

  // ================================================================
  // 拒绝列表：从以上所有规则里拉出来的广告 / 跟踪 / 遥测条目，写进 Rules/Reject 里各平台共用的 Reject（AI 段），配 REJECT。
  // 命中 v2fly_reject_attrs，或等于 / 属于下面域名的条目，会从各自的规则里移到这里。
  // 目前全部来自 v2fly 的 @ads / @telemetry 标记（OpenAI 的 Datadog / Sentry / Qualtrics、Copilot 遥测）
  // ================================================================
  "reject": {
    "domain_suffix": [],
    "domain": []
  }
}
