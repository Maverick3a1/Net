// 银行配置（香港银行 + Wise 等跨境账户）。改完运行 python3 scripts/build.py，会重新生成 Clash/ 和 Surge/。
// 只支持整行的 // 注释。
// 域名来自 v2fly 和各行官网首页实际引用的主机名；IP 来自 RIPEstat 查询各行自有 ASN。
{
  // ================================================================
  // 全局设置
  // ================================================================

  // 拒绝收录的过宽 DOMAIN-SUFFIX（只拦截完全相同的后缀）。
  // 中资行的母行域名（ccb.com、bankcomm.com、icbc.com.cn 等）是内地业务，
  // 只能收录其下的香港子域名，不能整段收录。
  "global_deny_suffix": [
    "akamaized.net",
    "alicdn.com",
    "alipay.com",
    "alipayobjects.com",
    "amazonaws.com",
    "azureedge.net",
    "bankcomm.com",
    "ccb.com",
    "citi.com",
    "citibank.com",
    "cloudflare.com",
    "cloudflare.net",
    "cloudfront.net",
    "ctfassets.net",
    "dbs.com",
    "google.com",
    "googleapis.com",
    "icbc.com.cn",
    "ocbc.com"
  ],

  // v2fly 中带这些属性的条目会被丢弃
  "v2fly_exclude_attrs": ["ads", "cn"],

  "banks": [
    // ================================================================
    // 发钞行 / 大型银行
    // ================================================================
    {
      "name": "HSBC",
      "description": "HSBC 汇丰银行（香港）",
      "sources": [
        {"type": "v2fly", "list": "hsbc"},
        // HSBC-HK-AS
        {"type": "asn", "asn": 9221}
      ],
      // v2fly 的 hsbc 列表 include 了 hsbc-cn（内地业务），这里去掉；
      // "hsbc" 是 .hsbc 顶级域，不是合法后缀规则
      "exclude": ["hsbc", "hsbc.com.cn", "hsbcqh.com.cn", "hsbcinsurance.com.cn"]
    },
    {
      "name": "StandardChartered",
      "description": "Standard Chartered 渣打银行（香港）",
      "sources": [
        {"type": "v2fly", "list": "standardchartered"},
        // SCB-AS-HK-AP / SCB1-AS-HK-AP
        {"type": "asn", "asn": 24112},
        {"type": "asn", "asn": 38166}
      ],
      "domain_suffix": ["standardchartered.com.hk"]
    },
    {
      "name": "BOCHK",
      "description": "Bank of China (Hong Kong) 中银香港",
      "sources": [
        // BOC-AS-HK
        {"type": "asn", "asn": 24396}
      ],
      "domain_suffix": ["bochk.com", "bochk.com.hk"]
    },
    {
      "name": "HangSeng",
      "description": "Hang Seng Bank 恒生银行",
      "sources": [],
      // hangseng.com.cn 是恒生中国（内地），不收录
      "domain_suffix": ["hangseng.com", "hangseng.com.hk"]
    },

    // ================================================================
    // 本地 / 中资 / 外资零售银行
    // ================================================================
    {
      "name": "BEA",
      "description": "The Bank of East Asia 东亚银行",
      "sources": [
        // BEAHK-AS-AP（目前没有宣告网段，有了会自动收录）
        {"type": "asn", "asn": 137452}
      ],
      "domain_suffix": ["hkbea.com", "hkbea-cyberbanking.com"]
    },
    {
      "name": "DBS",
      "description": "DBS Bank (Hong Kong) 星展银行（香港）",
      "sources": [
        // DBS-AS-AP - DBS Bank (Hong Kong) Limited
        {"type": "asn", "asn": 133852}
      ],
      // 网银在 internet-banking.hk.dbs.com；dbs.com 是集团全球域名，不整段收录
      "domain_suffix": ["dbs.com.hk", "hk.dbs.com"]
    },
    {
      "name": "Citibank",
      "description": "Citibank (Hong Kong) 花旗银行（香港）",
      "sources": [
        // CITI-HK-ISP_PEER-AP - Citibank N.A. Hong Kong
        {"type": "asn", "asn": 24568}
      ],
      "domain_suffix": ["citibank.com.hk", "citi.com.hk"]
    },
    {
      "name": "DahSing",
      "description": "Dah Sing Bank 大新银行",
      "sources": [],
      "domain_suffix": ["dahsing.com"]
    },
    {
      "name": "CNCBI",
      "description": "China CITIC Bank International 中信银行（国际）",
      "sources": [],
      "domain_suffix": ["cncbinternational.com"]
    },
    {
      "name": "CMBWingLung",
      "description": "CMB Wing Lung Bank 招商永隆银行",
      "sources": [],
      "domain_suffix": ["cmbwinglungbank.com", "winglungbank.com"]
    },
    {
      "name": "ICBCAsia",
      "description": "ICBC (Asia) 工银亚洲",
      "sources": [
        // ICBCASIA-AP
        {"type": "asn", "asn": 17487}
      ],
      "domain_suffix": ["icbcasia.com"],
      // 工银亚洲网银挂在母行 icbc.com.cn 下，只收这两个主机
      "domain": ["myebankasia.icbc.com.cn", "corpebankasia.icbc.com.cn"]
    },
    {
      "name": "CCBAsia",
      "description": "China Construction Bank (Asia) 建行亚洲",
      "sources": [
        // CCBASIA-ISG-HK-AP
        {"type": "asn", "asn": 38475}
      ],
      "domain_suffix": ["asia.ccb.com"]
    },
    {
      "name": "OCBC",
      "description": "OCBC Bank (Hong Kong) 华侨银行（香港）",
      "sources": [
        // OCBC-AS-AP - OCBC Bank (Hong Kong) Limited
        {"type": "asn", "asn": 4828}
      ],
      // ocbcwhhk.com 是原华侨永亨银行域名
      "domain_suffix": ["ocbc.com.hk", "ocbcwhhk.com"]
    },
    {
      "name": "Fubon",
      "description": "Fubon Bank (Hong Kong) 富邦银行（香港）",
      "sources": [],
      "domain_suffix": ["fubonbank.com.hk"]
    },
    {
      "name": "NCB",
      "description": "Nanyang Commercial Bank 南洋商业银行",
      "sources": [
        // NCBL-AS-AP - Nanyang Commercial Bank, Limited
        {"type": "asn", "asn": 152712}
      ],
      "domain_suffix": ["ncb.com.hk"]
    },
    {
      "name": "Chiyu",
      "description": "Chiyu Banking Corporation 集友银行",
      "sources": [],
      // cybhk.com 是网银域名；cybchina.com.cn 是内地分行，不收录
      "domain_suffix": ["chiyubank.com", "cybhk.com"]
    },
    {
      "name": "ShacomBank",
      "description": "Shanghai Commercial Bank 上海商业银行",
      "sources": [],
      "domain_suffix": ["shacombank.com.hk"]
    },
    {
      "name": "ChongHing",
      "description": "Chong Hing Bank 创兴银行",
      "sources": [],
      // chonghing.com 是无关的网店，不要加
      "domain_suffix": ["chbank.com"]
    },
    {
      "name": "BoComHK",
      "description": "Bank of Communications (Hong Kong) 交通银行（香港）",
      "sources": [
        // BOCOMM-AS-AP - Bank of Communications (Hong Kong) Limited
        {"type": "asn", "asn": 133926}
      ],
      "domain_suffix": ["bankcomm.com.hk", "hk.bankcomm.com"]
    },

    // ================================================================
    // 虚拟银行
    // ================================================================
    {
      "name": "ZABank",
      "description": "ZA Bank 众安银行",
      "sources": [],
      // zaticdn.com 是众安自有 CDN
      "domain_suffix": ["za.group", "zabank.com.hk", "zaticdn.com"]
    },
    {
      "name": "Mox",
      "description": "Mox Bank",
      "sources": [],
      "domain_suffix": ["mox.com"]
    },
    {
      "name": "WeLab",
      "description": "WeLab Bank 汇立银行",
      "sources": [
        // WELABBANKLIMITED-AS-AP（目前没有宣告网段，有了会自动收录）
        {"type": "asn", "asn": 150700}
      ],
      "domain_suffix": ["welab.bank"]
    },
    {
      "name": "Livi",
      "description": "livi bank 理慧银行",
      "sources": [],
      "domain_suffix": ["livibank.com"]
    },
    {
      "name": "EleBank",
      "description": "EleBank 大象银行（原 Airstar Bank 天星银行）",
      "sources": [],
      "domain_suffix": ["elebank.com", "airstarbank.com"]
    },
    {
      "name": "PAOB",
      "description": "Ping An OneConnect Bank 平安壹账通银行",
      "sources": [],
      // paob.com.hk 现在跳转到 pingandb.com
      "domain_suffix": ["paob.com.hk", "pingandb.com"]
    },
    {
      "name": "Fusion",
      "description": "Fusion Bank 富融银行",
      "sources": [],
      "domain_suffix": ["fusionbank.com"]
    },
    {
      "name": "AntBank",
      "description": "Ant Bank (Hong Kong) 蚂蚁银行（香港）",
      "sources": [],
      // 静态资源走支付宝共用 CDN（alipayobjects.com），不收录
      "domain_suffix": ["antbank.hk"]
    },

    // ================================================================
    // 跨境汇款 / 多币种账户
    // ================================================================
    {
      "name": "Wise",
      "description": "Wise（原 TransferWise）",
      "sources": [
        {"type": "v2fly", "list": "wise"},
        // Transferwise-est（目前没有宣告网段，有了会自动收录）
        {"type": "asn", "asn": 208550}
      ],
      // wise.com 首页引用的 Wise 自有 CloudFront 分发（logo 等静态资源）
      "domain": ["dq8dwmysp7hk1.cloudfront.net", "daw291njkc3ao.cloudfront.net"]
    }
  ],

  // ================================================================
  // 合集：以上所有银行合并为 Bank.list / Bank.yaml
  // ================================================================
  "aggregate": {
    "name": "Bank",
    "description": "All banks above combined"
  }
}
