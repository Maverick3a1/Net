// 银行配置（香港银行 + Wise 等跨境账户）。改完运行 python3 scripts/build.py，会重新生成 Clash/ 和 Surge/。
// 只支持整行的 // 注释。
// 域名来自 v2fly 和各行官网首页实际引用的主机名；IP 来自 RIPEstat 查询各行自有 ASN。
{
  // ================================================================
  // 全局设置
  // ================================================================

  // 拒绝收录的过宽 DOMAIN-SUFFIX（只拦截完全相同的后缀）。
  // 中资行的母行域名（ccb.com、bankcomm.com、icbc.com.cn 等）是内地业务，
  // 只能收录其下的香港子域名，不能整段收录。
  "global_deny_suffix": [
    "akamaized.net",
    "alicdn.com",
    "alipay.com",
    "alipayobjects.com",
    "amazonaws.com",
    "azureedge.net",
    "bankcomm.com",
    "ccb.com",
    "citi.com",
    "citibank.com",
    "cloudflare.com",
    "cloudflare.net",
    "cloudfront.net",
    "ctfassets.net",
    "dbs.com",
    "google.com",
    "googleapis.com",
    "icbc.com.cn",
    "ocbc.com"
  ],

  // v2fly 中带这些属性的条目会被丢弃
  "v2fly_exclude_attrs": ["cn"],

  // v2fly 中带这些属性的条目（广告 / 遥测）放进拒绝列表，而不是普通规则
  "v2fly_reject_attrs": ["ads", "telemetry"],

  "banks": [
    // ================================================================
    // 发钞行 / 大型银行
    // ================================================================
    {
      "name": "HSBC",
      "description": "HSBC 汇丰银行（香港）",
      "sources": [
        {"type": "v2fly", "list": "hsbc"},
        // HSBC-HK-AS
        {"type": "asn", "asn": 9221},
        // HSBC HK App 依赖的埋点 / 反欺诈 / 客服 SDK 域名
        {"type": "forecho", "list": "Bank", "conf": "hsbc"}
      ],
      // v2fly 的 hsbc 列表 include 了 hsbc-cn（内地业务），这里去掉；
      // "hsbc" 是 .hsbc 顶级域，不是合法后缀规则
      "exclude": ["hsbc", "hsbc.com.cn", "hsbcqh.com.cn", "hsbcinsurance.com.cn"],
      // hsbcpb.com 汇丰私人银行、hsbckinetic.co.uk 汇丰英国商业银行 App（TLS 证书均属 HSBC Group）；
      // hsbcdigital 是 HSBC 网银内嵌的 Qualtrics 问卷（会进 Rules/Reject）
      // hsbc.hk 跳转到 hsbc.com.hk（证书属汇丰香港）
      "domain_suffix": ["hsbc.hk", "hsbcpb.com", "hsbckinetic.co.uk", "hsbcdigital.siteintercept.qualtrics.com"],
      // HSBC 自有的 Azure CDN 存储（来自 klchai/personal-rule）
      "domain": ["cdnhsbcrhostorage.azureedge.net"]
    },
    {
      "name": "StandardChartered",
      "description": "Standard Chartered 渣打银行（香港）",
      "sources": [
        {"type": "v2fly", "list": "standardchartered"},
        // SCB-AS-HK-AP / SCB1-AS-HK-AP
        {"type": "asn", "asn": 24112},
        {"type": "asn", "asn": 38166}
      ],
      "domain_suffix": ["standardchartered.com.hk"]
    },
    {
      "name": "BOCHK",
      "description": "Bank of China (Hong Kong) 中银香港",
      "sources": [
        // BOC-AS-HK
        {"type": "asn", "asn": 24396}
      ],
      // bocgroup.com 返回中银香港自己的 EV 证书；boccc.com.hk 是中银信用卡（CT 证书 O=中银香港）
      // ftcwifi.com：crt.sh 中 EV 证书 O=Bank of China (Hong Kong) Ltd，NS 与 bochk.com 相同（imsbiz.com），主机解析到中银香港自有网段 202.127.168.0/21
      "domain_suffix": ["bochk.com", "bochk.com.hk", "bocgroup.com", "boccc.com.hk", "ftcwifi.com"],
      "domain": [
        // 来自 Telegram 机器人（用户确认）：经济通 ETNet（AS9906）的主机，名称含 bochk，疑似中银香港 App 的股票行情服务；根域 etdsinfo.com 属 ETNet，未收录
        "bochk01.etdsinfo.com",
        // 来自 Telegram 机器人（用户确认）：同 bochk01，ETNet（AS9906）主机，疑似中银香港 App 的行情服务；根域属 ETNet，未收录
        "bochk02.etdsinfo.com"
      ]
    },
    {
      "name": "HangSeng",
      "description": "Hang Seng Bank 恒生银行",
      "sources": [],
      // hangseng.com.cn 是恒生中国（内地），不收录
      "domain_suffix": ["hangseng.com", "hangseng.com.hk"]
    },

    // ================================================================
    // 本地 / 中资 / 外资零售银行
    // ================================================================
    {
      "name": "BEA",
      "description": "The Bank of East Asia 东亚银行",
      "sources": [
        // BEAHK-AS-AP（目前没有宣告网段，有了会自动收录）
        {"type": "asn", "asn": 137452}
      ],
      // hkbea-beany.com 是东亚的 BEANY 站点（证书 O=The Bank of East Asia）
      "domain_suffix": ["hkbea.com", "hkbea-cyberbanking.com", "hkbea-beany.com"]
    },
    {
      "name": "DBS",
      "description": "DBS Bank (Hong Kong) 星展银行（香港）",
      "sources": [
        // DBS-AS-AP - DBS Bank (Hong Kong) Limited
        {"type": "asn", "asn": 133852}
      ],
      // 网银在 internet-banking.hk.dbs.com；dbs.com 是集团全球域名，不整段收录
      "domain_suffix": ["dbs.com.hk", "hk.dbs.com"]
    },
    {
      "name": "Citibank",
      "description": "Citibank (Hong Kong) 花旗银行（香港）",
      "sources": [
        // CITI-HK-ISP_PEER-AP - Citibank N.A. Hong Kong
        {"type": "asn", "asn": 24568}
      ],
      "domain_suffix": ["citibank.com.hk", "citi.com.hk"]
    },
    {
      "name": "DahSing",
      "description": "Dah Sing Bank 大新银行",
      "sources": [],
      // dahsing.com.hk 301 跳转到 www.dahsing.com（来自 LingJingMaster/Shadowrocket-Rules）
      "domain_suffix": ["dahsing.com", "dahsing.com.hk"]
    },
    {
      "name": "CNCBI",
      "description": "China CITIC Bank International 中信银行（国际）",
      "sources": [],
      // cncbintl.com 的证书 O=China CITIC Bank International（CT 记录）
      // cncbinternational2.com：crt.sh 中 EV / OV 证书 O=China CITIC Bank International Limited（移动设备管理 / 应用网关）
      "domain_suffix": ["cncbinternational.com", "cncbintl.com", "cncbinternational2.com"]
    },
    {
      "name": "CMBWingLung",
      "description": "CMB Wing Lung Bank 招商永隆银行",
      "sources": [],
      "domain_suffix": ["cmbwinglungbank.com", "winglungbank.com"]
    },
    {
      "name": "ICBCAsia",
      "description": "ICBC (Asia) 工银亚洲",
      "sources": [
        // ICBCASIA-AP
        {"type": "asn", "asn": 17487}
      ],
      "domain_suffix": ["icbcasia.com"],
      // 工银亚洲网银挂在母行 icbc.com.cn 下，只收这两个主机
      // icbc-asia / mobilehk 在同一张工银证书里，是工银亚洲网站和手机银行
      "domain": [
        "corpebankasia.icbc.com.cn",
        "icbc-asia.icbc.com.cn",
        "mobilehk.icbc.com.cn",
        "myebankasia.icbc.com.cn"
      ]
    },
    {
      "name": "CCBAsia",
      "description": "China Construction Bank (Asia) 建行亚洲",
      "sources": [
        // CCBASIA-ISG-HK-AP
        {"type": "asn", "asn": 38475}
      ],
      // ccbhk.com（App 接入网关）、ccbasiahk.com（API 网关 / 无卡取款）的证书 O=建行亚洲（CT 记录）
      "domain_suffix": ["asia.ccb.com", "ccbhk.com", "ccbasiahk.com"]
    },
    {
      "name": "OCBC",
      "description": "OCBC Bank (Hong Kong) 华侨银行（香港）",
      "sources": [
        // OCBC-AS-AP - OCBC Bank (Hong Kong) Limited
        {"type": "asn", "asn": 4828}
      ],
      // ocbcwhhk.com 是原华侨永亨银行域名
      "domain_suffix": ["ocbc.com.hk", "ocbcwhhk.com"]
    },
    {
      "name": "Fubon",
      "description": "Fubon Bank (Hong Kong) 富邦银行（香港）",
      "sources": [],
      // fubon-queuehk.com 是分行排队取号（证书 O=Fubon Bank (Hong Kong)）
      "domain_suffix": ["fubonbank.com.hk", "fubon-queuehk.com"]
    },
    {
      "name": "NCB",
      "description": "Nanyang Commercial Bank 南洋商业银行",
      "sources": [
        // NCBL-AS-AP - Nanyang Commercial Bank, Limited
        {"type": "asn", "asn": 152712}
      ],
      // nanyang-bank.com 的证书 O=Nanyang Commercial Bank（CT 记录）
      "domain_suffix": ["ncb.com.hk", "nanyang-bank.com"]
    },
    {
      "name": "Chiyu",
      "description": "Chiyu Banking Corporation 集友银行",
      "sources": [],
      // cybhk.com 是网银域名；cybchina.com.cn 是内地分行，不收录
      "domain_suffix": ["chiyubank.com", "cybhk.com"]
    },
    {
      "name": "ShacomBank",
      "description": "Shanghai Commercial Bank 上海商业银行",
      "sources": [],
      // shacombank.com 返回上海商业银行自己的 EV 证书；shacom.com 是台湾的上海商业储蓄银行，不收录
      "domain_suffix": ["shacombank.com.hk", "shacombank.com"]
    },
    {
      "name": "ChongHing",
      "description": "Chong Hing Bank 创兴银行",
      "sources": [],
      // chonghing.com 是无关的网店，不要加
      "domain_suffix": ["chbank.com"]
    },
    {
      "name": "BoComHK",
      "description": "Bank of Communications (Hong Kong) 交通银行（香港）",
      "sources": [
        // BOCOMM-AS-AP - Bank of Communications (Hong Kong) Limited
        {"type": "asn", "asn": 133926}
      ],
      "domain_suffix": ["bankcomm.com.hk", "hk.bankcomm.com"]
    },

    // ================================================================
    // 虚拟银行
    // ================================================================
    {
      "name": "ZABank",
      "description": "ZA Bank 众安银行",
      "sources": [
        {"type": "forecho", "list": "Bank", "conf": "zabank"}
      ],
      // zaticdn.com 是众安自有 CDN
      // zabank.com 302 跳转到 bank.za.group（来自 javievv/proxy-rules）
      "domain_suffix": ["za.group", "zabank.com.hk", "zaticdn.com", "zabank.com"]
    },
    {
      "name": "Mox",
      "description": "Mox Bank",
      "sources": [],
      // moxbank.com 跳转到 mox.com
      "domain_suffix": ["mox.com", "moxbank.com"]
    },
    {
      "name": "WeLab",
      "description": "WeLab Bank 汇立银行",
      "sources": [
        // WELABBANKLIMITED-AS-AP（目前没有宣告网段，有了会自动收录）
        {"type": "asn", "asn": 150700}
      ],
      "domain_suffix": ["welab.bank"]
    },
    {
      "name": "Livi",
      "description": "livi bank 理慧银行",
      "sources": [],
      // livi.com 跳转到 livibank.com
      "domain_suffix": ["livibank.com", "livi.com"]
    },
    {
      "name": "EleBank",
      "description": "EleBank 大象银行（原 Airstar Bank 天星银行）",
      "sources": [
        {"type": "forecho", "list": "Bank", "conf": "elebank"}
      ],
      "domain_suffix": ["elebank.com", "airstarbank.com"]
    },
    {
      "name": "PAOB",
      "description": "Ping An OneConnect Bank 平安壹账通银行",
      "sources": [],
      // paob.com.hk 现在跳转到 pingandb.com
      "domain_suffix": ["paob.com.hk", "pingandb.com"]
    },
    {
      "name": "Fusion",
      "description": "Fusion Bank 富融银行",
      "sources": [],
      "domain_suffix": ["fusionbank.com"]
    },
    {
      "name": "AntBank",
      "description": "Ant Bank (Hong Kong) 蚂蚁银行（香港）",
      "sources": [],
      // 静态资源走支付宝共用 CDN（alipayobjects.com），不收录
      "domain_suffix": ["antbank.hk"],
      // 蚂蚁银行自己的 CDN 和日志入口（来自 LeventLei/shadowrocket-rules；日志会进 Rules/Reject）
      "domain": ["antbank-cdn.marmot-cloud.com", "ant-hkbank-linkd.cn-hongkong.log.aliyuncs.com"]
    },

    // ================================================================
    // 跨境汇款 / 多币种账户
    // ================================================================
    {
      "name": "Wise",
      "description": "Wise（原 TransferWise）",
      "sources": [
        {"type": "v2fly", "list": "wise"},
        {"type": "forecho", "list": "Bank", "conf": "wise"},
        // Transferwise-est（目前没有宣告网段，有了会自动收录）
        {"type": "asn", "asn": 208550}
      ],
      // tw.ee：crt.sh 中 OV 证书 O=WISE PAYMENTS LIMITED，301 跳转到 transferwise.com
      "domain_suffix": ["tw.ee"],
      // wise.com 首页引用的 Wise 自有 CloudFront 分发（logo 等静态资源）
      "domain": ["dq8dwmysp7hk1.cloudfront.net", "daw291njkc3ao.cloudfront.net"]
    },

    // ================================================================
    // 多家银行 App 共用的第三方服务：风控 / 反欺诈 / 应用加固 / 客服 SDK 等。
    // 不属于任何一家银行，但银行 App 要靠它们正常工作（有的还会核对出口 IP），
    // 所以和银行走同一个策略。只收你确认过的（Telegram 机器人建议、你点选后写入）。
    // ================================================================
    {
      "name": "BankShared",
      "description": "银行 App 共用的第三方服务（风控 / 反欺诈 / 应用加固 / 客服 SDK）",
      "sources": [],
      "domain_suffix": [
        // 来自 Telegram 机器人（用户确认）：Zimperium 移动应用防护（zDefend/zShield）SDK 的 CDN，证书 *.zimperium.com，经 Cloudflare；Reject 及各分类均未收录
        "zimperium.com"
      ],
      "domain": []
    }
  ],

  // ================================================================
  // 合集：以上所有银行合并为 Bank.list / Bank.yaml
  // ================================================================
  "aggregate": {
    "name": "Bank_All",
    "description": "香港银行和 Wise 合集"
  },

  // ================================================================
  // 拒绝列表：从以上所有规则里拉出来的广告 / 跟踪 / 遥测条目，写进 Rules/Reject 里各平台共用的 Reject（Bank 段），配 REJECT。
  // 命中 v2fly_reject_attrs，或等于 / 属于下面域名的条目，会从各自的规则里移到这里。
  // 来自 forecho 的银行 App SDK。ThreatMetrix（online-metrix.net）、BioCatch（we-stats.com）、
  // AWS WAF、LivePerson 是风控 / 客服，银行会核对它们的出口 IP，不放进拒绝列表
  // ================================================================
  "reject": {
    "domain_suffix": [
      "app-measurement.com",
      "appsflyersdk.com",
      "siteintercept.qualtrics.com",
      "crashlytics.com",
      "eum-appdynamics.com",
      "lytics.io",
      "mixpanel.com",
      "optimizely.com",
      "tealiumiq.com",
      "tiqcdn.com"
    ],
    "domain": ["ant-hkbank-linkd.cn-hongkong.log.aliyuncs.com"]
  }
}
