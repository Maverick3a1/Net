// Rules4Crypto 交易所配置。改完推送到 main，scripts/build.py 会重新生成 Clash/ 和 Surge/。
// 只支持整行的 // 注释。
{
  // ================================================================
  // 全局设置
  // ================================================================

  // 拒绝收录的过宽 DOMAIN-SUFFIX（只拦截完全相同的后缀，
  // 比如 okx.com.cdn.cloudflare.net 不受 cloudflare.net 影响）
  "global_deny_suffix": [
    "amazonaws.com",
    "appsflyersdk.com",
    "azureedge.net",
    "cloudflare.com",
    "cloudflare.net",
    "cloudfront.net",
    "ctfassets.net",
    "github.com",
    "github.io",
    "githubusercontent.com",
    "google.com",
    "googleapis.com",
    "gstatic.com",
    "onelink.me",
    "prismic.io",
    "sanity.io",
    "statuspage.io",
    "zendesk.com"
  ],

  // v2fly 中带这些属性的条目会被丢弃
  "v2fly_exclude_attrs": ["ads", "cn"],

  "exchanges": [
    // ================================================================
    // Binance：币安主站 / Binance.US / BNB Chain / API
    // ================================================================
    {
      "name": "Binance",
      "description": "Binance, Binance.US, BNB Chain",
      "sources": [
        {"type": "v2fly", "list": "binance"}
      ]
    },

    // ================================================================
    // OKX：交易所 / Web3 钱包 / X Layer
    // ================================================================
    {
      "name": "OKX",
      "description": "OKX (formerly OKEx), OKX Wallet, X Layer",
      "sources": [
        {"type": "v2fly", "list": "okx"}
      ]
    },

    // ================================================================
    // Bybit
    // ================================================================
    {
      "name": "Bybit",
      "description": "Bybit",
      "sources": [
        {"type": "v2fly", "list": "bybit"}
      ]
    },

    // ================================================================
    // Coinbase：Coinbase / Advanced Trade / Coinbase Wallet
    // （v2fly 没有单独列表，手工维护；走 Cloudflare / AWS，不收录 IP）
    // ================================================================
    {
      "name": "Coinbase",
      "description": "Coinbase, Coinbase Advanced, Coinbase Wallet",
      "sources": [],
      "domain_suffix": [
        "coinbase.com",
        // 静态资源 CDN
        "cbhq.net",
        // 旧品牌 GDAX
        "gdax.com"
      ]
    },

    // ================================================================
    // Bitget（v2fly 没有单独列表，手工维护）
    // ================================================================
    {
      "name": "Bitget",
      "description": "Bitget",
      "sources": [],
      "domain_suffix": [
        "bitget.com",
        "bitget.site",
        "bitgetapp.com",
        "bitgetapps.com",
        // 静态资源 CDN
        "bgbstatic.com",
        "bgstatic.com"
      ]
    },

    // ================================================================
    // Upbit：韩国 Upbit / Upbit 新加坡、印尼、泰国（运营方 Dunamu）
    // ================================================================
    {
      "name": "Upbit",
      "description": "Upbit (Dunamu)",
      "sources": [
        // Dunamu 自有 ASN
        {"type": "asn", "asn": 10154}
      ],
      "domain_suffix": [
        "upbit.com",
        "dunamu.com"
      ]
    },

    // ================================================================
    // Gate：Gate.com / Gate.io
    // ================================================================
    {
      "name": "Gate",
      "description": "Gate (Gate.com, Gate.io)",
      "sources": [
        {"type": "v2fly", "list": "gateio"}
      ]
    },

    // ================================================================
    // MEXC（v2fly 没有单独列表，手工维护）
    // ================================================================
    {
      "name": "MEXC",
      "description": "MEXC",
      "sources": [],
      "domain_suffix": [
        "mexc.com",
        "mexc.co",
        "mexcsensors.com"
      ]
    },

    // ================================================================
    // HTX：火币
    // ================================================================
    {
      "name": "HTX",
      "description": "HTX (formerly Huobi)",
      "sources": [
        {"type": "v2fly", "list": "huobi"}
      ]
    },

    // ================================================================
    // KuCoin
    // ================================================================
    {
      "name": "KuCoin",
      "description": "KuCoin, KuCoin TH, KuCoin TR",
      "sources": [
        {"type": "v2fly", "list": "kucoin"}
      ],
      "domain_suffix": [
        "kucoin.club",
        "kucoin.th",
        "kucoin.tr",
        "kucoinauth.cloud",
        // 静态资源 CDN
        "staticimg.com"
      ]
    },

    // ================================================================
    // Kraken：Kraken / Kraken Pro（母公司 Payward）
    // ================================================================
    {
      "name": "Kraken",
      "description": "Kraken, Kraken Pro",
      "sources": [
        {"type": "v2fly", "list": "kraken"},
        // Payward (Kraken) 自有 ASN
        {"type": "asn", "asn": 1072}
      ],
      "domain_suffix": [
        "krak.app",
        "payward.com"
      ]
    },

    // ================================================================
    // Crypto.com（v2fly 没有单独列表，手工维护）
    // ================================================================
    {
      "name": "CryptoCom",
      "description": "Crypto.com App and Exchange",
      "sources": [],
      "domain_suffix": [
        "crypto.com"
      ]
    },

    // ================================================================
    // Bithumb（v2fly 没有单独列表，手工维护）
    // ================================================================
    {
      "name": "Bithumb",
      "description": "Bithumb",
      "sources": [],
      "domain_suffix": [
        "bithumb.com",
        "bithumbcorp.com"
      ]
    },

    // ================================================================
    // BingX（v2fly 没有单独列表，手工维护）
    // ================================================================
    {
      "name": "BingX",
      "description": "BingX (formerly Bingbon)",
      "sources": [],
      "domain_suffix": [
        "bingx.com",
        "bingbon.com",
        // 静态资源 CDN
        "bb-os.com"
      ]
    },

    // ================================================================
    // Bitfinex（v2fly 没有单独列表，手工维护）
    // ================================================================
    {
      "name": "Bitfinex",
      "description": "Bitfinex",
      "sources": [],
      "domain_suffix": [
        "bitfinex.com"
      ]
    },

    // ================================================================
    // Bitstamp（v2fly 没有单独列表，手工维护）
    // ================================================================
    {
      "name": "Bitstamp",
      "description": "Bitstamp",
      "sources": [],
      "domain_suffix": [
        "bitstamp.net",
        "bitstamp.com"
      ]
    },

    // ================================================================
    // Gemini 交易所（不是 Google Gemini）
    // ================================================================
    {
      "name": "Gemini",
      "description": "Gemini Exchange (not Google Gemini)",
      "sources": [
        // Gemini 自有 ASN
        {"type": "asn", "asn": 6651},
        {"type": "asn", "asn": 50363},
        {"type": "asn", "asn": 203107}
      ],
      "domain_suffix": [
        "gemini.com"
      ]
    },

    // ================================================================
    // bitFlyer
    // ================================================================
    {
      "name": "bitFlyer",
      "description": "bitFlyer",
      "sources": [
        {"type": "v2fly", "list": "bitflyer"}
      ]
    },

    // ================================================================
    // Deribit：期权交易所
    // ================================================================
    {
      "name": "Deribit",
      "description": "Deribit",
      "sources": [
        {"type": "v2fly", "list": "deribit"},
        // Deribit 自有 ASN
        {"type": "asn", "asn": 207856}
      ]
    },

    // ================================================================
    // Hyperliquid：链上永续合约交易所（v2fly 没有单独列表，手工维护）
    // ================================================================
    {
      "name": "Hyperliquid",
      "description": "Hyperliquid",
      "sources": [],
      "domain_suffix": [
        "hyperliquid.xyz"
      ]
    }
  ],

  // ================================================================
  // 合集：以上所有交易所合并为 Crypto.list / Crypto.yaml
  // ================================================================
  "aggregate": {
    "name": "Crypto",
    "description": "All exchanges above combined"
  }
}
