// Broker 券商配置。改完推送到 main，scripts/build.py 会重新生成 Clash/ 和 Surge/。
// 只支持整行的 // 注释。
// 手工维护的域名均已通过 TLS 证书主体或券商官网前端代码核实归属。
// 收录原则：只收这些港美股券商自己使用的域名，不收内地券商（以及与内地券商共用）的域名。
// 券商境内技术公司的 .cn 域名（如富途 futu.cn、老虎 tigerbbs.cn、长桥 longbridge.cn）
// 是券商自家 App 使用的，予以保留。
{
  // ================================================================
  // 全局设置
  // ================================================================

  // 拒绝收录的过宽 DOMAIN-SUFFIX（只拦截完全相同的后缀）
  "global_deny_suffix": [
    "aliyuncs.com",
    "amazonaws.com",
    "cloudflare.com",
    "cloudflare.net",
    "cloudfront.net",
    "ctfassets.net",
    "github.com",
    "google.com",
    "googleapis.com",
    "gstatic.com",
    "myqcloud.com",
    "qcloud.com",
    "udesk.cn"
  ],

  // v2fly 中带这些属性的条目会被丢弃
  "v2fly_exclude_attrs": [],

  // v2fly 中带这些属性的条目（广告 / 遥测）放进拒绝列表，而不是普通规则
  "v2fly_reject_attrs": ["ads", "telemetry"],

  // 内地证券公司域名黑名单：命中的条目一律剔除；拉取失败则本次不发布任何规则
  "mainland_deny_v2fly": ["category-securities-cn"],

  "brokers": [
    // ================================================================
    // 中资互联网券商
    // ================================================================

    // 富途：富途牛牛 / moomoo
    {
      "name": "Futu",
      "description": "富途证券: 富途牛牛, moomoo",
      "sources": [
        {"type": "v2fly", "list": "futu"},
        {"type": "forecho", "list": "Broker", "conf": "futu"}
      ],
      // moomoo 各地区域名、富途清算（上游未收录）；fututrust.com 是富途信托（证书 O=Futu Trustee Limited）；
      // futucrypto / fututradehub / fttradehub / futuhk8 的 CT 证书 O=Futu Securities International (Hong Kong)
      "domain_suffix": [
        "fttradehub.com",
        "futuclearing.com",
        "futucrypto.com",
        "futuhk8.com",
        "fututradehub.com",
        "fututrust.com",
        "moomooapp.com",
        "moomoobull.com",
        "moomoocn.com",
        "panthertrade.com"
      ]
    },

    // 老虎证券：Tiger Trade / 老虎国际
    {
      "name": "Tiger",
      "description": "老虎证券: Tiger Trade, Tiger Brokers",
      "sources": [
        {"type": "v2fly", "list": "itiger"},
        {"type": "blackmatrix7", "list": "TigerFintech"},
        {"type": "forecho", "list": "Broker", "conf": "tiger"}
      ],
      // 老虎各地区站点 / 备用域名：页面均为老虎国际官网，NS 与老虎其他域名同在 AWS / DNSPod；
      // tigersecurities.com 证书 O=Tiger Brokers (Singapore)。来自 imdp6/hk-broker-rules、
      // yindudegugezhanghao-lgtm/hk-brokers-rules 等社区规则
      "domain_suffix": [
        "atigrpulse.com",
        "atigrzen.com",
        "etasphere.com",
        "gotigerhk.com",
        "itigertrader.com",
        "thetigerbrokers.com",
        "tigerbrokers.com.au",
        "tigerbrokers.com.hk",
        "tigerbrokers.com.sg",
        "tigerhkgo.com",
        "tigersecurities.com",
        "tigertrader.app",
        "tigrdw.com",
        "tigrgood.com",
        "tigrwd.com"
      ]
    },

    // 长桥证券：Longbridge / LongPort
    {
      "name": "Longbridge",
      "description": "长桥证券: Longbridge, LongPort",
      "sources": [
        {"type": "v2fly", "list": "longbridge"},
        {"type": "forecho", "list": "Broker", "conf": "longbridge"}
      ],
      // longportwhale.com 是长桥的 WHALE 券商云服务
      "domain_suffix": ["longportwhale.com"],
      // 长桥桌面端安装包所在的阿里云 OSS 存储桶（来自 imdp6/hk-broker-rules）
      "domain": ["lb-hk-desktop.oss-cn-hongkong.aliyuncs.com"]
    },

    // 盈立证券：uSMART（v2fly 没有单独列表，手工维护）
    {
      "name": "uSMART",
      "description": "盈立证券: uSMART",
      "sources": [],
      // usmart-app.com 是 uSMART App 下载页
      "domain_suffix": [
        "usmart-app.com",
        "usmart.hk",
        "usmart.sg",
        "usmart11.com",
        "usmart22.com",
        "usmart66.com",
        "usmart8.com",
        "usmartbroker.com",
        "usmartcapital.com",
        "usmartfinance.com",
        "usmartglobal.com",
        "usmartgroup.com",
        "usmarthk.com",
        "usmartinvest.com",
        "usmartsecurities.com",
        "usmartsg.com",
        "usmarttrade.com",
        "usmartus.com",
        "ylzqhk.com",
        "ylzqsg.com",
        "yxzjhk.com",
        "yxzjsg.com",
        "yxzq.com"
      ],
      // 在线客服（udesk 是共用 SaaS，只收录盈立的子域）
      "domain": ["yxzq.udesk.cn"]
    },

    // 华盛证券：华盛通 / Valuable（手工维护）
    {
      "name": "Valuable",
      "description": "华盛证券: 华盛通, Valuable",
      "sources": [
        {"type": "forecho", "list": "Broker", "conf": "hstong"}
      ],
      // vbkhk / vbkrhk / vclbrokers / vbkr.cn 的 CT 证书 O=Valuable Capital Limited
      "domain_suffix": [
        "vbkhk.com",
        "vbkr.cn",
        "vbkrhk.com",
        "vclbrokers.com",
        "hstong.com",
        "valuable.com.hk",
        "vbkr.com"
      ]
    },

    // 雪盈证券（雪球旗下）
    // 不引用 v2fly/xueqiu、blackmatrix7/XueQiu：其中的 xueqiu.com、imedao.com 是雪球 App
    // 与内地券商 A 股交易共用的域名，danjuanfunds.com 等是内地蛋卷基金，均非雪盈专用
    {
      "name": "Snowball",
      "description": "雪盈证券 Snowball Securities",
      "sources": [
        {"type": "forecho", "list": "Broker", "conf": "snowball"}
      ],
      // snbsecurities.com 是雪盈 OpenAPI 域名（返回 *.snowballsecurities.com 证书）
      "domain_suffix": ["snbsecurities.com", "snowballsecurities.com"]
    },

    // 艾德证券：Eddid ONE（手工维护）
    {
      "name": "Eddid",
      "description": "艾德证券: Eddid ONE",
      "sources": [],
      "domain_suffix": [
        "eddid.com.hk",
        "eddid.com.sg",
        "eddidapp.com",
        "eddidfin.com",
        "eddidusa.com"
      ]
    },

    // 华泰国际：涨乐全球通（只收录香港站点，不含内地华泰证券 htsc.com.cn）
    {
      "name": "HuataiIntl",
      "description": "华泰国际: 涨乐全球通",
      "sources": [],
      // zhangleglobal.com 是涨乐全球通（证书 O=Huatai Financial Holdings (Hong Kong) Limited）
      "domain_suffix": ["htsc.com.hk", "zhangleglobal.com"]
    },

    // 复星国际证券（复星恒利 Fosun Hani）/ 复星财富
    {
      "name": "Fosun",
      "description": "复星国际证券: 复星恒利, 复星财富",
      "sources": [
        {"type": "forecho", "list": "Broker", "conf": "fosun"}
      ],
      // fosunwealth.cn 是复星财富境内技术公司（星财智科技）的域名
      "domain_suffix": ["fosunwealth.cn"]
    },

    // 卓锐证券 Sharp Point
    {
      "name": "ZR",
      "description": "卓锐证券 Sharp Point",
      "sources": [
        {"type": "forecho", "list": "Broker", "conf": "zr"}
      ]
    },

    // 微牛：Webull 各地区站点（手工维护）
    {
      "name": "Webull",
      "description": "微牛 Webull",
      "sources": [],
      "domain_suffix": [
        "wb4magxg.com",
        "wbapiservxg.com",
        "wbausecurities.com",
        "wbjpsecurities.com",
        "wbsecurities.com",
        "wbsgsecurities.com",
        "wbzasecurities.com",
        "webull-uk.com",
        "webull-us.com",
        "webull.ca",
        "webull.co.id",
        "webull.co.jp",
        "webull.co.th",
        "webull.co.za",
        "webull.com",
        "webull.com.au",
        "webull.com.br",
        "webull.com.my",
        "webull.com.sg",
        "webull.hk",
        "webullapp.com",
        "webullbroker.com",
        "webullcorp.com",
        "webullfinance.com",
        "webullfintech.com",
        "webullpay.com",
        // 微牛泰国（CT 证书 O=Webull Securities Limited）
        "wbthsecurities.com"
      ]
    },

    // ================================================================
    // 美国本土券商
    // ================================================================

    // 盈透证券 Interactive Brokers
    {
      "name": "IBKR",
      "description": "盈透证券 Interactive Brokers",
      "sources": [
        {"type": "v2fly", "list": "ibkr"},
        // Interactive Brokers LLC / Corp 自有 ASN
        {"type": "asn", "asn": 11449},
        {"type": "asn", "asn": 27163},
        {"type": "asn", "asn": 27164},
        {"type": "asn", "asn": 40711},
        {"type": "asn", "asn": 400227},
        // IBKR Financial Services AG（欧洲）
        {"type": "asn", "asn": 9096},
        {"type": "asn", "asn": 207241},
        {"type": "asn", "asn": 212141}
      ],
      // CT 证书 O=Interactive Brokers LLC 的客户端相关域名（不含 ibgdr.com 等清算 / 内部网关）
      "domain_suffix": [
        "clientam.com",
        "ibkr-svc.com",
        "interactivebrokers.ch",
        "interactivebrokers.sg"
      ],
      // 盈透的加密货币交易由 Paxos 托管
      "domain": ["ibkr.paxosclients.com"]
    },

    // 嘉信理财 Charles Schwab（含 thinkorswim）
    {
      "name": "Schwab",
      "description": "嘉信理财 Charles Schwab, thinkorswim",
      "sources": [
        {"type": "v2fly", "list": "schwab"},
        // Charles Schwab & Co. 自有 ASN
        {"type": "asn", "asn": 1399},
        {"type": "asn", "asn": 6949},
        {"type": "forecho", "list": "Broker", "conf": "schwab"}
      ],
      // CT 证书 O=Charles Schwab & Co.：TD Ameritrade（已并入嘉信）、嘉信银行、图片 CDN、机构顾问平台
      "domain_suffix": [
        "schwabbank.com",
        "schwabimg.com",
        "schwabinstitutional.com",
        "tdameritrade.com"
      ]
    },

    // 第一证券 Firstrade（v2fly 只在 category-finance 里有主域名，手工维护）
    {
      "name": "Firstrade",
      "description": "第一证券 Firstrade",
      "sources": [],
      "domain_suffix": [
        "firstrade.com",
        "firstrade.info",
        "firstrade.net"
      ]
    },

    // Robinhood
    {
      "name": "Robinhood",
      "description": "Robinhood",
      "sources": [
        // Robinhood Markets 自有 ASN
        {"type": "asn", "asn": 29981}
      ],
      "domain_suffix": [
        "aboutrobinhood.com",
        "rhinternal.net",
        "robinhood.com",
        "robinhood.net"
      ]
    },

    // ================================================================
    // 行情 / 共用基础设施（来自 forecho/broker-rules）
    // ================================================================

    // TradingView：券商站点和 App 内嵌的托管图表也走它
    {
      "name": "TradingView",
      "description": "TradingView 图表 / 行情",
      "sources": [
        {"type": "forecho", "list": "Broker", "conf": "tradingview"}
      ]
    },

    // forecho Broker.list 里不属于上面任何一个 conf 的规则：多家券商 App 共用的 SDK
    // （_shared.conf）、腾讯云 / 阿里云 / AWS 网段（_ip.conf），以及 forecho 以后新增、
    // 这里还没对应的券商（构建输出会列出来，再按需拆成单独的条目）
    {
      "name": "BrokerShared",
      "description": "券商 App 共用 SDK 域名和云服务器 IP",
      "sources": [
        {"type": "forecho", "list": "Broker", "rest": true}
      ]
    }
  ],

  // ================================================================
  // 合集：以上所有券商合并为 Broker.list / Broker.yaml
  // ================================================================
  "aggregate": {
    "name": "Broker_All",
    "description": "All brokers above combined"
  },

  // ================================================================
  // 拒绝列表：从以上所有规则里拉出来的广告 / 跟踪 / 遥测条目，写进 Rules/Reject 里各平台共用的 Reject（Broker 段），配 REJECT。
  // 命中 v2fly_reject_attrs，或等于 / 属于下面域名的条目，会从各自的规则里移到这里。
  // 来自 forecho（AppsFlyer、moomoo 采集入口）和 blackmatrix7 TigerFintech（play-analytics.com）
  // ================================================================
  "reject": {
    "domain_suffix": [
      "appsflyersdk.com",
      "play-analytics.com"
    ],
    "domain": [
      "collect.us.moomoocrypto.com"
    ]
  }
}
